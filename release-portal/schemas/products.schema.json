{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Portal products",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products"],
  "properties": {
    "schemaVersion": {"const": 1},
    "products": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "repository", "entryType", "webUrl", "name", "tagline", "category", "logo", "defaultBranch", "aiPolicy"],
        "properties": {
          "productId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
          "entryType": {"enum": ["web", "download"]},
          "webUrl": {"type": ["string", "null"], "format": "uri"},
          "name": {"$ref": "#/$defs/bilingual"},
          "tagline": {"$ref": "#/$defs/bilingual"},
          "category": {"type": "string", "minLength": 1},
          "logo": {"type": ["string", "null"]},
          "defaultBranch": {"type": "string", "minLength": 1},
          "aiPolicy": {"const": "metadata-only"}
        }
      }
    }
  },
  "allOf": [
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "ai4ms"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "spec-agent"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "poly-agent"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "speclabos"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "ragportal"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"contains": {"properties": {"productId": {"const": "smartaccess"}}, "required": ["productId"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"products": {"items": {"oneOf": [
      {"properties": {"productId": {"const": "ai4ms"}, "repository": {"const": "SynlysAI/AI4MS"}, "entryType": {"const": "web"}, "webUrl": {"const": "https://ai4ms.xmuzc.com/"}}},
      {"properties": {"productId": {"const": "spec-agent"}, "repository": {"const": "SynlysAI/Spec_Agent"}, "entryType": {"const": "web"}, "webUrl": {"const": "https://specagent.xmuzc.com/"}}},
      {"properties": {"productId": {"const": "poly-agent"}, "repository": {"const": "SynlysAI/Poly_Agent"}, "entryType": {"const": "web"}, "webUrl": {"const": "https://polyagent.xmuzc.com/"}}},
      {"properties": {"productId": {"const": "speclabos"}, "repository": {"const": "SynlysAI/SpecLabOS"}, "entryType": {"const": "web"}, "webUrl": {"const": "https://speclabos.xmuzc.com/"}}},
      {"properties": {"productId": {"const": "ragportal"}, "repository": {"const": "SynlysAI/RAGPortal"}, "entryType": {"const": "web"}, "webUrl": {"const": "https://ragportal.xmuzc.com/"}}},
      {"properties": {"productId": {"const": "smartaccess"}, "repository": {"const": "SynlysAI/SmartAccess"}, "entryType": {"const": "download"}, "webUrl": {"const": null}}}
    ]}}}}
  ],
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {"zh": {"type": "string"}, "en": {"type": "string"}}
    }
  }
}
