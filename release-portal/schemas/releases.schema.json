{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Portal releases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "productId", "version", "name", "body", "publishedAt", "releaseUrl", "prerelease", "draft", "assets"],
        "properties": {
          "id": {"type": "string"},
          "productId": {"enum": ["ai4ms", "spec-agent", "poly-agent", "speclabos", "ragportal", "smartaccess"]},
          "version": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "body": {"type": "string"},
          "publishedAt": {"type": ["string", "null"], "format": "date-time"},
          "releaseUrl": {"type": ["string", "null"], "format": "uri"},
          "prerelease": {"type": "boolean"},
          "draft": {"type": "boolean"},
          "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "platform", "architecture", "sha256", "downloadPath"],
      "properties": {
        "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "platform": {"type": "string"},
        "architecture": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "downloadPath": {"type": "string"}
      }
    }
  }
}
